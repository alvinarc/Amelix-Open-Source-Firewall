# Copy this file to .env and fill in your real keys.
# Amelix works in degraded/offline mode without these (local heuristics only)
# but threat-intel lookups will be skipped/cached-empty until keys are set.

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=

# Optional: override cache location / TTL (seconds)
AMELIX_CACHE_DIR=.amelix_cache
AMELIX_CACHE_TTL=3600
